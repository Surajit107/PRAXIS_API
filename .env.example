# Server
PORT=8000
NODE_ENV=development
PRAXIS_API_HOST_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Redis (public JSON caching + express-session store)
# Optional for local/dev (falls back to MemoryStore with a warning).
# Required on live/production for durable OAuth sessions across restarts.
# Shared Key Value with AI-FEEDBACK: keep REDIS_KEY_PREFIX = praxisapi:
REDIS_URL=
REDIS_KEY_PREFIX=praxisapi:

# Auth / JWT
EXPRESS_SESSION_SECRET=change-me-session-secret
ACCESS_TOKEN_SECRET=change-me-access-token-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
REFRESH_TOKEN_EXPIRY=10d

# Mail (Resend + mailgen)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# Default Payment Provider (stripe | razorpay | paypal) — preferred for clients; all three stay wired
DEFAULT_PAYMENT_PROVIDER=stripe

# Payment — Stripe (default)
# Webhook URL: POST {PRAXIS_API_HOST_URL}/stripe/webhook
# Dashboard → Developers → Webhooks → endpoint pointing here; events: payment_intent.succeeded
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# Payment — Razorpay (optional — put real keys to enable)
RAZORPAY_KEY_ID=__razorpay_key_id__
RAZORPAY_KEY_SECRET=__razorpay_key_secret__

# Payment — PayPal (optional — put real keys to enable)
PAYPAL_CLIENT_ID=__paypal_client_id__
PAYPAL_SECRET=__paypal_secret__

# Google OAuth
GOOGLE_CLIENT_ID=__google_client_id__
GOOGLE_CLIENT_SECRET=__google_client_secret__
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/users/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=__github_client_id__
GITHUB_CLIENT_SECRET=__github_client_secret__
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/users/github/callback

# Frontend redirects
CLIENT_SSO_REDIRECT_URL=http://localhost:3000/user/profile
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:3000/forgot-password

# Jest (throwaway DB; name must contain "test"; truncated every suite)
TEST_DATABASE_URL=postgresql://praxisapi:praxisapi@localhost:5432/praxisapi_test
