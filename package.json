{
  "name": "praxis-api",
  "version": "1.3.1",
  "description": "PraxisAPI — practice APIs (Express + PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "nodemon --import ./scripts/register-path-aliases.js --import dotenv/config --experimental-json-modules src/index.js",
    "start:prod": "node --import ./scripts/register-path-aliases.js --import dotenv/config --experimental-json-modules src/index.js",
    "start:docker": "node --import ./scripts/register-path-aliases.js --import dotenv/config scripts/docker-boot.js && npm run start:prod",
    "db:generate": "node --import ./scripts/register-path-aliases.js ./node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.js",
    "db:migrate": "node --import ./scripts/register-path-aliases.js ./node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.js",
    "db:drop-all": "node scripts/drop-all.js",
    "db:seed:public": "node --import ./scripts/register-path-aliases.js --import dotenv/config scripts/seed-public-json.js",
    "db:seed:geo": "node --import ./scripts/register-path-aliases.js --import dotenv/config scripts/seed-geo.js",
    "json:generate:world": "node scripts/generate-world-json.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --watch",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/unit",
    "test:health": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/healthcheck.test.js",
    "test:todo": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/apps/todo.test.js",
    "test:auth": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/apps/auth.test.js",
    "test:ecommerce": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/apps/ecommerce",
    "test:payments": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/apps/ecommerce/payment.test.js",
    "test:social": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/apps/social-media",
    "test:chat": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/apps/chat-app",
    "test:public": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/public",
    "test:ops": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/ops",
    "test:seeds": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/seeds",
    "test:verification": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/verification"
  },
  "keywords": [
    "praxis-api",
    "praxisapi",
    "open source",
    "api as a service",
    "public apis",
    "kitchen sink"
  ],
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "8.4.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-compression": "^1.0.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mailgen": "^2.0.36",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nanoid": "^6.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "postgres": "^3.4.9",
    "razorpay": "^2.9.8",
    "request-ip": "^3.3.0",
    "resend": "^6.28.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
